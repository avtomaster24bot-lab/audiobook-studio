# Каталоги
DATA_DIR=./data
MUSIC_DIR=./music

# LLM для атрибуции реплик и эмоций (необязательно; без ключа — rule-based режим).
# Любой OpenAI-совместимый API: OpenAI, OpenRouter, DeepSeek, Ollama, vLLM, LM Studio
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_DISABLED=0

# TTS: silero (локально, бесплатно), edge (онлайн, бесплатно), elevenlabs (по ключу)
TTS_ENGINES=silero,edge
NARRATOR_VOICE=edge-svetlana
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Формат: Имя:voice_id:male,Имя2:voice_id2:female
ELEVENLABS_VOICES=
TORCH_THREADS=4

# Аудио
TARGET_LUFS=-16
MUSIC_GAIN_DB=-12
MP3_BITRATE=320k

# Краулер
CRAWLER_USER_AGENT=AudiobookStudioBot/0.1 (+https://github.com/avtomaster24bot-lab/audiobook-studio)
CRAWL_DELAY_SEC=1.0
MAX_WORDS=500000

# Очередь
WORKERS=1
